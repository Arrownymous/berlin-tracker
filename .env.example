SITE_PASSWORD=

# Upstash Redis (wordt automatisch gezet als je de Upstash-integratie in Vercel koppelt).
# Een van beide paren is genoeg.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
